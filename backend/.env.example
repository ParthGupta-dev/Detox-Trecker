# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only .env.example belongs in Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────

# Supabase POOLED connection string (used by the running Express app via Prisma)
# Find it in: Supabase Dashboard → Project → Connect → Connection string → Transaction mode
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:6543/postgres?pgbouncer=true"

# Supabase DIRECT connection string (used by Prisma migrations only; NOT needed at runtime)
# Find it in: Supabase Dashboard → Project → Connect → Connection string → Direct connection
# Note: this may be IPv6-only on some plans; use the session-mode pooler string if migration fails.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────

# Long random secret for signing session tokens/cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a DIFFERENT value for local, CI, and production.
SESSION_SECRET="replace-me-with-a-long-random-string"

# ── CORS ──────────────────────────────────────────────────────────────────────

# The exact origin of the frontend. Only this origin is allowed by CORS.
# Local dev: http://localhost:3000
# Production: the Vercel deployment URL (no trailing slash)
FRONTEND_ORIGIN="http://localhost:3000"

# ── Node ──────────────────────────────────────────────────────────────────────

# "development" locally, "test" in CI, "production" on Render.
NODE_ENV="development"
