# ─────────────────────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — only .env.example belongs in Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────

# The full base URL of the Express backend (no trailing slash).
# NEXT_PUBLIC_ prefix makes this visible in the browser — that is FINE here
# because this is just a URL, not a secret.
#
# Local dev:   http://localhost:4000
# Production:  your Render service URL (set this in Vercel dashboard, not here)
NEXT_PUBLIC_API_URL="http://localhost:4000"
